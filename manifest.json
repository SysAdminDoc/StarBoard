{
  "manifest_version": 3,
  "name": "StarBoard",
  "version": "1.2.0",
  "description": "Your entire GitHub repo list, sorted most stars to least, with star/fork deltas since your last check.",
  "author": "SysAdminDoc",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "alarms", "offscreen"],
  "host_permissions": ["https://api.github.com/*"],
  "optional_host_permissions": ["https://github.com/*"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "StarBoard — GitHub repo standings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
