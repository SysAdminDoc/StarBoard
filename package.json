{
  "name": "starboard",
  "version": "1.5.0",
  "private": true,
  "description": "Chrome extension: your GitHub repos ranked by stars, with star and fork deltas.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "icons": "py -3.12 scripts/make_icons.py",
    "locales": "node scripts/build_locales.mjs",
    "screenshots:store": "node scripts/render_store_screenshots.mjs",
    "build": "py -3.12 scripts/build.py",
    "check": "node scripts/check.mjs && node scripts/build_locales.mjs --check",
    "typecheck": "tsc -p jsconfig.json && tsc -p jsconfig.scripts.json",
    "test": "npm run typecheck && npm run test:unit && npm run test:release && npm run test:smoke",
    "test:unit": "node tests/unit.mjs",
    "test:release": "py -3.12 tests/release_test.py",
    "test:smoke": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "playwright": "1.62.1",
    "typescript": "^7.0.2"
  }
}
